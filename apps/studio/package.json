{
  "name": "@strongr/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:hosted": "vite build --mode hosted-preview",
    "build:content-review-preview": "vite build --mode development-review",
