{
  "name": "strongr-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "boundaries:check": "node scripts/ci/validate-environment-boundaries.ts",
    "build": "tsc -p tsconfig.build.json",
    "ci": "bash scripts/ci/run_m1_foundation.sh",
    "format:check": "biome format apps packages scripts/ci package.json tsconfig.json tsconfig.build.json biome.json",
    "lint": "biome lint apps packages scripts/ci",
    "schema:check": "node scripts/ci/generate-content-schemas.ts --check",
    "schema:generate": "node scripts/ci/generate-content-schemas.ts",
    "test": "node --test apps/studio/test/environment.test.ts apps/worker/test/environment.test.ts apps/worker/test/durable-worker.test.ts apps/worker/test/supabase-rpc.test.ts packages/ai/test/deterministic-adapter.test.ts packages/content-schemas/test/audio-reflection.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
